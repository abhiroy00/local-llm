{
  "name": "local-llm",
  "version": "0.0.0",
  "private": true,
  "description": "DevPilot AI repository root. The VS Code extension package lives in devpilot-ai/; these scripts delegate to it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-extension-deps.mjs",
    "build": "npm --prefix devpilot-ai run build",
    "typecheck": "npm --prefix devpilot-ai run typecheck",
    "lint": "npm --prefix devpilot-ai run lint",
    "test": "npm --prefix devpilot-ai run test",
    "check": "npm --prefix devpilot-ai run check",
    "package": "npm --prefix devpilot-ai run package",
    "test:host": "npm --prefix devpilot-ai run test:host",
    "smoke:agent": "npm --prefix devpilot-ai run smoke:agent",
    "smoke:inspection": "npm --prefix devpilot-ai run smoke:inspection",
    "model:setup": "npm --prefix devpilot-ai run model:setup --",
    "smoke:coding": "npm --prefix devpilot-ai run smoke:coding --"
  }
}
